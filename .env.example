# ─────────────────────────────────────────────────────────────────────────────
# Hyundai SmartReserve / AVA — Environment Variables Template
# Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────────────────────────────────────

# AI Cloud Reasoning (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Speech & Voice (OPTIONAL: System automatically uses 100% FREE Microsoft Neural Edge-TTS & Browser Web Speech for Hindi/Marathi/English with zero subscription)
SARVAM_API_KEY=your_sarvam_api_subscription_key_here

# Open Charge Map live station sync (Optional)
OCM_API_KEY=1f545914-8daa-4fa6-9d7b-4a6819f2f7cc

# Razorpay Escrow deposit (Optional mock mode active by default)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
